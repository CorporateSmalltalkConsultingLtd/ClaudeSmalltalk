processAccessor

	| a |
	processAccessor
		ifNil: 
			[a _ OSProcessAccessor forThisOSProcess.
			a isResponsibleForThisPlatform ifTrue:
				[processAccessor _ a.
				processAccessor addDependent: self]].
	^ processAccessor! !
