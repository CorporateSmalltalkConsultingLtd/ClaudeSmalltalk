!PositionableStream methodsFor: '*SqueakCompatibility-nonhomogeneous accessing' stamp: ''!
            nextNumber: n 
	"Answer the next n bytes as a positive Integer or LargePositiveInteger."
	| s |
	s := 0.
	1 to: n do: 
		[:i | s := (s bitShift: 8) bitOr: self next asInteger].
	^ s normalize! !
