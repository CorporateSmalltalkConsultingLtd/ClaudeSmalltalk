                        port

	<primitive: 'primitiveSocketAddressGetPort' module: 'SocketPlugin'>
	self primitiveFailed
! !
!SocketAddress methodsFor: 'primitives' stamp: 'ikp 9/Jun/2007 08:21:00'!
                 port: anInteger

