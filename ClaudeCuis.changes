    testLockFileIfFail

	"(self selector: #testLockFileIfFail) run"

	| fail |
	fail _ false.
	accessor lockFile: fileStream ifFail: [fail _ true].
	self shouldnt: fail.
	fileStream close.
	accessor lockFile: fileStream ifFail: [fail _ true].
	self should: fail
