"override 'cause Object defines this"
	^self at: 'name'! !
!JsonObject methodsFor: 'accessing' stamp: 'rh 27/Feb/2010 00:04:00'!
                          value
"override 'cause Object defines this"
	^self at: 'value'! !
!JsonObject methodsFor: 'as yet unclassified' stamp: 'rh 19/Feb/2010 21:33:00'!
              doesNotUnderstand: aMessage
	| key |
	key := aMessage selector.
	key isUnary ifTrue: [^ self at: key ifAbsent: [nil]].
	^ (key isKeyword and: [(key occurrencesOf: $:) = 1])
		ifTrue: [key := key allButLast asSymbol.
				self at: key put: aMessage arguments first]
		ifFalse: [super doesNotUnderstand: aMessage]
				
	! !
!JsonObject class methodsFor: 'as yet unclassified' stamp: 'Igor.Stasenko 9/Jan/2010 16:51:00'!
                               fromAssociations: collectionOfAssociations

	| result |
	result := self new.
	
	collectionOfAssociations do: [:each |
		result at: each key put: each value ].
	^ result! !
!Object methodsFor: '*JSON' stamp: 'Igor.Stasenko 9/Jan/2010 16:18:00'!
            asJsonString

	^ String streamContents: [:str |
		self jsonWriteOn: str ]! !
!Array2D methodsFor: '*JSON' stamp: 'jmv 11/Jul/2018 17:33:20'!
                   jsonWriteOn: aStream
	"By default, use array braces "
	aStream nextPut: $[.
	1 to: height
		do: [ :i |
			aStream nextPut: $[.
				1 to: width
					do: [ :j | elements jsonWriteElement: (self i: i j: j) on: aStream ]
					separatedBy: [aStream nextPut: $, ; space].
			aStream nextPut: $] ]
		separatedBy: [aStream nextPut: $, ; newLine ].
	aStream nextPut: $]! !
!Collection methodsFor: '*JSON' stamp: 'jmv 17/May/2016 13:11:00'!
                 jsonObjectWriteOn: aStream
	"Write as 'JSON Object' format
	This is a list of (name:value) pairs, and is analogous to Smalltalk Dictionaries where names (keys) are strings.
	Assume the receiver is either:
	- a Dictionary
	- a collection of Association objects (or some sort of object that on #jsonWriteOn: print like an Association)"

	| needComma |
	needComma := false.
	aStream nextPut: ${.
	self associationsDo: [ :assoc |
		needComma
			ifTrue: [ aStream nextPut: $, ; space]
			ifFalse: [ needComma := true ].
		assoc jsonWriteOn: aStream ].
	aStream nextPut: $}! !
!Collection methodsFor: '*JSON' stamp: 'jmv 11/Jul/2018 17:31:14'!
  jsonWriteElement: element on: aStream
	"Allow for specific subclasses (FloatArray, using 32 bit Floats!!) to use specific way to write its elements"

	element jsonWriteOn: aStream! !
!Collection methodsFor: '*JSON' stamp: 'jmv 11/Jul/2018 17:31:50'!
      jsonWriteOn: aStream
	"By default, use array braces "
	| useNewLines |
	aStream nextPut: $[.

	useNewLines _ nil.
	self do: [ :each |
		useNewLines ifNil: [
			useNewLines _ each isLiteral not ].
		self jsonWriteElement: each on: aStream.
	] separatedBy: [
		aStream nextPut: $, .
		useNewLines ifTrue: [ aStream newLine ]].

	aStream nextPut: $]! !
!FloatArray methodsFor: '*JSON' stamp: 'jmv 11/Jul/2018 18:14:09'!
                               jsonWriteElement: element on: aStream
	"FloatArray elements are answered as 64 bit Float, but are really 32 bit Float.
	When writing to JSON (or printing), print them as 32 bit Float."

	element printAsIEEE32BitPrecisionFloatOn: aStream base: 10! !
!CharacterSequence methodsFor: '*JSON-writing' stamp: 'jmv 25/Nov/2022 12:38:09'!
                     jsonWriteOn: aStream

	aStream nextPut: $".
	self do: [ :ch |
		(Json escapeForCharacter: ch)
			ifNil: [ aStream nextPut: ch ]
			ifNotNil: [ :replacement |
				aStream nextPutAll: replacement ] ].
	aStream nextPut: $".
! !
!Text methodsFor: '*JSON-printing' stamp: 'cwp 26/Oct/2006 22:25:00'!
                         jsonWriteOn: aStream
	self string jsonWriteOn: aStream! !
!Dictionary methodsFor: '*JSON-writing' stamp: 'jmv 17/May/2016 12:47:00'!
                           jsonWriteOn: aStream
	"Dictionaries are written as 'JSON Objects'
	Use the general implementation for that."

	self jsonObjectWriteOn: aStream! !
!WriteStream methodsFor: '*JSON-printing' stamp: 'cwp 25/Oct/2006 12:27:00'!
 jsonPrint: anObject
	anObject jsonWriteOn: self! !
!False methodsFor: '*JSON-writing' stamp: 'tonyg 17/Aug/2005 00:43:00'!
     jsonWriteOn: aStream
	aStream nextPutAll: 'false'! !
!True methodsFor: '*JSON-writing' stamp: 'tonyg 17/Aug/2005 00:44:00'!
    jsonWriteOn: aStream
	aStream nextPutAll: 'true'! !
!Number methodsFor: '*JSON-writing' stamp: 'ul 4/Nov/2008 04:46:00'!
       jsonWriteOn: aWriteStream 

	self printOn: aWriteStream base: 10! !
!Integer methodsFor: '*JSON-writing' stamp: 'Igor.Stasenko 27/Dec/2009 08:05:00'!
          jsonWriteOn: aWriteStream
	^ self printOn: aWriteStream base: 10
! !
!Association methodsFor: '*JSON-writing' stamp: 'jmv 2/Jun/2016 09:35:00'!
                jsonWriteOn: aStream
	self key asString jsonWriteOn: aStream.
	aStream nextPut: $:; space.
	self value jsonWriteOn: aStream.! !
!UndefinedObject methodsFor: '*JSON-writing' stamp: 'tonyg 17/Aug/2005 00:45:00'!
              jsonWriteOn: aWriteStream 
	aWriteStream nextPutAll: 'null'! !
!FileEntry methodsFor: '*json' stamp: 'pb 25/May/2016 01:32:00'!
jsonContents
	"
	'noesta.json' asFileEntry jsonContents
	"
	^self readStreamDo: [ :stream |
		Json readFrom: stream ]! !

Json initialize!

