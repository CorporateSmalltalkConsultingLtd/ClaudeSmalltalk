{
  "version": "3.0",
  "description": "xAI Grok as the agent LLM",
  "model": {
    "provider": "xai",
    "name": "grok-3-mini",
    "apiKeyEnv": "XAI_API_KEY",
    "maxTokens": "####"
  },
  "vm": {
    "image": "/path/to/ClaudeSqueak.image",
    "binary": "/path/to/Squeak-or-Cuis-VM-binary"
  },
  "transport": {
    "type": "tcp",
    "host": "127.0.0.1",
    "port": 9876,
    "timeout": 180
  }
}