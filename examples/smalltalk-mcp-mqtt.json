{
  "version": "1.0",
  "description": "Example: MQTT transport — connects to Smalltalk image via MQTT broker",
  "model": {
    "provider": "anthropic",
    "name": "claude-sonnet-4-6",
    "maxTokens": 256000,
    "apiKeyEnv": "ANTHROPIC_API_KEY"
  },
  "vm": {
    "squeak": "/Applications/Squeak6.0-22148-64bit.app/Contents/MacOS/Squeak",
    "cuis": "/Applications/CuisVM.app/Contents/MacOS/Squeak"
  },
  "image": {
    "selected": "cuis",
    "squeak": "ClaudeSqueak.image",
    "cuis": "ClaudeCuis.image"
  },
  "transport": {
    "type": "mqtt",
    "broker": "localhost",
    "port": 1883,
    "usernameEnv": "MQTT_USERNAME",
    "passwordEnv": "MQTT_PASSWORD",
    "imageId": "dev1",
    "timeout": 180
  }
}
