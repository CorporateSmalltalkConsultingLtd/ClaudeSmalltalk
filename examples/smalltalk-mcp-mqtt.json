{
  "version": "3.0",
  "description": "MQTT transport — connects to a remote/Cuis image via MQTT broker",
  "model": {
    "provider": "ollama",
    "name": "qwen2.5-coder:32b",
    "baseUrl": "http://localhost:11434",
    "maxTokens": "####"
  },
  "transport": {
    "type": "mqtt",
    "broker": "192.168.1.158",
    "port": 1883,
    "usernameEnv": "MQTT_USERNAME",
    "passwordEnv": "MQTT_PASSWORD",
    "imageId": "dev1",
    "timeout": 30
  }
}
